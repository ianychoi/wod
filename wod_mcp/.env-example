# --- LLM credentials (reused from llmops; needed for analyze/recommend) ---
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL_NAME=gpt-4o

AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_key

# Use a Bedrock model ID enabled in your account/region. The dated snapshot
# below has an EOL sibling (claude-3-5-sonnet-20240620) that Bedrock rejects with
# "This model version has reached the end of its life" — prefer a current ID.
AWS_BEDROCK_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
# Vision-capable Llama on Bedrock (added as a 4th comparison model).
AWS_BEDROCK_LLAMA_MODEL=us.meta.llama4-scout-17b-instruct-v1:0
AWS_BEDROCK_PROFILE_NAME=default
AWS_BEDROCK_REGION_NAME=us-west-2

LANGCHAIN_TEMPERATURE=0.7

# --- deliver_feedback safety gate ---
# Live posting is refused unless this is set AND dry_run=False is passed.
# Leave unset for the demo (dry-run only).
WOD_DELIVER_ENABLED=
